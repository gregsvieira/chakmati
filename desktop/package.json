{
  "name": "lite-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Floating robot assistant for lite-agent",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "snapshot": "LITEAGENT_DESKTOP_SNAPSHOT=1 electron .",
    "prestart": "node scripts/prepare-electron.js",
    "postinstall": "node scripts/prepare-electron.js",
    "abrir": "open -n node_modules/electron/dist/Electron.app --args \"$PWD\""
  },
  "devDependencies": {
    "electron": "^45.0.0"
  }
}
